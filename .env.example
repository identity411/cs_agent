# Local-only AGX account configuration.
# Copy to .env (chmod 600) and fill in the values. Never commit .env.
#
# Shared defaults for every account:
RSI_URL=https://your-agx-instance.example
RSI_COMPETITION_ID=2a97f94f-816a-52b7-b4b8-5925db160245
# Competition IDs by game (shared). Use --competition-id fps|racing or
# --game-id fps|racing instead of pasting the UUID:
RSI_COMPETITION_FPS=2a97f94f-816a-52b7-b4b8-5925db160245
RSI_COMPETITION_RACING=1eb91364-950b-5725-aa4b-3501b16860ec
# Optional default account selector: "main" or a named account.
RSI_ACCOUNT=

# Default account "main" (legacy names; keep the existing values here).
RSI_ACCOUNT_API_KEY=your-one-time-account-api-key
RSI_AGENT_ID=

# Additional accounts. Names start with a letter and contain only letters,
# digits and underscores; matching is case-insensitive.
# RSI_ACCOUNT_ALICE_API_KEY=...
# RSI_ACCOUNT_ALICE_AGENT_ID=...
# Numbered shorthand is also accepted: RSI_ACCOUNT_API_KEY_2 is exposed as
# account "account2"; RSI_ACCOUNT_AGENT_ID_2 or RSI_AGENT_ID_2 are optional.
# RSI_ACCOUNT_API_KEY_2=...
# RSI_ACCOUNT_COMPETITION_ID_2=2a97f94f-816a-52b7-b4b8-5925db160245
# Optional per-account overrides; otherwise the shared values above apply.
# A competition value may be a UUID or a game alias such as "fps"/"racing":
# RSI_ACCOUNT_ALICE_URL=
# RSI_ACCOUNT_ALICE_COMPETITION_ID=racing

# Optional explicit account order. Also declares an account whose API key is
# stored only in the macOS Keychain (service "agx-api-key-<name>"; "main"
# also falls back to "agx-api-key").
# RSI_ACCOUNTS=main,alice,bob
#
# Do not mix RSI_ACCOUNT_MAIN_* with RSI_ACCOUNT_API_KEY/RSI_AGENT_ID; use
# exactly one form for the main account.
